FROM registry.redhat.io/rhoai/odh-pipeline-runtime-datascience-cpu-py312-rhel9@sha256:7c8dcca6b0127f27309ca1381fd267a9320162446fef5519575156dc33e1cbc7
USER 0
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN python -m venv /opt/rag-venv
ENV PATH="/opt/rag-venv/bin:${PATH}"
RUN python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.10.0+cpu torchvision==0.25.0+cpu
RUN mkdir -p /opt/rag && python -m pip install --index-url https://pypi.org/simple --report /opt/rag/pip-install-report.json docling==2.151.1 docling-core==2.108.0 docling-ibm-models==4.0.4 pypdf==6.21.4 pdfplumber==0.11.9 PyMuPDF==1.26.6 kfp==2.18.1 boto3==1.43.122 && python -m pip check && python -m pip freeze > /opt/rag/requirements.lock
RUN python -c 'from pathlib import Path; Path("/opt/rag/prefetch_models.py").write_text("import hashlib, json\nfrom pathlib import Path\nfrom huggingface_hub import HfApi, snapshot_download\nfrom transformers import AutoTokenizer\nfrom docling.datamodel.pipeline_options import LayoutObjectDetectionOptions\nroot = Path(\"/opt/rag/models\")\nroot.mkdir(parents=True, exist_ok=True)\napi = HfApi()\nlayout = LayoutObjectDetectionOptions().model_spec\nspecs = [\n    (layout.repo_id, layout.revision, None),\n    (\"docling-project/docling-models\", \"v2.3.0\", [\"model_artifacts/tableformer/accurate/*\", \"README.md\", \"LICENSE*\"]),\n]\nmanifest = {\"models\": [], \"tokenizer_purpose\": \"qualification only; embedding model selection remains open\"}\nfor repo, revision, patterns in specs:\n    sha = api.model_info(repo, revision=revision).sha\n    dest = root / repo.replace(\"/\", \"--\")\n    snapshot_download(repo_id=repo, revision=sha, local_dir=dest, allow_patterns=patterns)\n    manifest[\"models\"].append({\"repo\": repo, \"requested_revision\": revision, \"commit\": sha, \"directory\": str(dest), \"allow_patterns\": patterns})\nrepo = \"sentence-transformers/all-MiniLM-L6-v2\"\nsha = api.model_info(repo).sha\nAutoTokenizer.from_pretrained(repo, revision=sha, trust_remote_code=False).save_pretrained(root / \"tokenizer\")\nmanifest[\"tokenizer\"] = {\"repo\": repo, \"commit\": sha, \"directory\": str(root / \"tokenizer\"), \"embedding_model_deployed\": False}\nmanifest[\"files\"] = {}\nfor p in sorted(root.rglob(\"*\")):\n    if p.is_file() and \".cache\" not in p.parts:\n        manifest[\"files\"][str(p.relative_to(root))] = hashlib.sha256(p.read_bytes()).hexdigest()\nPath(\"/opt/rag/model-manifest.json\").write_text(json.dumps(manifest, indent=2))\nprint(json.dumps({k:v for k,v in manifest.items() if k != \"files\"}, indent=2))\n")'
RUN python /opt/rag/prefetch_models.py
RUN chmod -R a+rX /opt/rag /opt/rag-venv
ENV HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TRANSFORMERS_OFFLINE=1 DOCLING_ARTIFACTS_PATH=/opt/rag/models HOME=/tmp PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false
USER 1001
WORKDIR /tmp
CMD ["python", "-c", "import docling, kfp, torch; print(torch.__version__)"]
